    private static void newUserAccount(Connection connection) throws SQLException {
        System.out.println("** Create your account **");

        System.out.println("Enter your First Name");
        String ame = sc.next();
        System.out.println("Enter your middle Name");
        String mName = sc.next();
        String Name = ame + " " + mName;

        System.out.println("Enter Your pin : ");
        int pin = sc.nextInt();

        Random ran = new Random();
        int accountNumber = ran.nextInt();
        double balance = 0.0;
        //String query = "CREATE TABLE IF NOT EXIST Public_bank (name VARCHAR (30),pin INT, atmNumber INT,balance DOUBLE)"; I HARD CODED IT
        String query = "INSERT INTO Public_bank(name,pin,accountNumber,balance) VALUES(?,?,?,?)";
        PreparedStatement preparedStatement = connection.prepareStatement(query);
        preparedStatement.setString(1, Name);
        preparedStatement.setInt(2, pin);
        preparedStatement.setInt(3, accountNumber);
        preparedStatement.setDouble(4, balance);

        int rowsAffected = preparedStatement.executeUpdate();
        if (rowsAffected > 0) {
            System.out.println("Your Account Created Successfully");
        } else {
            System.out.println("Error ");
        }
        if (preparedStatement != null) {
            preparedStatement.close();
        }
    }

    private static void checkBalance(Connection connection) throws SQLException {
